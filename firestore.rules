rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. GLOBAL SAFETY NET: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. STUDIO PROJECTS COLLECTION: Strictly Owner-Only with Field Validation
    match /studio_projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(projectId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && (!('status' in request.resource.data) || request.resource.data.status in ['draft', 'submitted', 'archived'])
        && request.resource.data.keys().hasOnly(['ownerId', 'title', 'businessName', 'status', 'config', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn()
        && isValidId(projectId)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 120))
        && incomingDiff(resource.data).affectedKeys().hasOnly(['title', 'businessName', 'status', 'config', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(projectId) && resource.data.ownerId == request.auth.uid;
    }

    // 3. PUBLIC FORM COLLECTIONS: Denied to direct client operations
    // All submissions must pass through server-side Cloud Functions with App Check
    match /inquiries/{inquiryId} {
      allow read, write: if false;
    }

    match /preview_requests/{requestId} {
      allow read, write: if false;
    }

    match /consent_audit_logs/{logId} {
      allow read, write: if false;
    }

    function incomingDiff(existingData) {
      return request.resource.data.diff(existingData);
    }
  }
}
